{
  "tracking": {
    "completionReport": {
      "defaultMode": "markdown"
    },
    "retention": {
      "enabled": true,
      "rawLogDays": 7
    }
  },
  "cursor": {
    "argvPrefix": [
      "agent"
    ],
    "defaultModel": "composer-2.5"
  },
  "droid": {
    "binary": "droid",
    "models": {
      "my-model": "replace-with-your-droid-model-id"
    }
  },
  "policy": {
    "profile": "safe",
    "work": {
      "networkAccess": true
    }
  },
  "codex": {
    "binary": "codex",
    "defaultModel": null,
    "profile": null,
    "workSandbox": "workspace-write",
    "ephemeral": true,
    "ignoreUserConfig": false
  }
}
