{
  "tracking": {
    "completionReport": {
      "defaultMode": "markdown"
    },
    "retention": {
      "enabled": true,
      "rawLogDays": 7
    }
  },
  "cursor": {
    "argvPrefix": [
      "agent"
    ],
    "defaultModel": "composer-2.5",
    "defaultReasoningEffort": null,
    "reasoningEffortModels": {}
  },
  "droid": {
    "binary": "droid",
    "defaultReasoningEffort": null,
    "models": {
      "reviewer": "replace-with-read-only-model-id",
      "implementer": "replace-with-edit-capable-model-id"
    }
  },
  "reasoning": {
    "capabilities": {}
  },
  "policy": {
    "profile": "safe",
    "work": {
      "networkAccess": true
    }
  },
  "codex": {
    "binary": "codex",
    "defaultModel": null,
    "defaultReasoningEffort": null,
    "profile": null,
    "workSandbox": "workspace-write",
    "ephemeral": true,
    "ignoreUserConfig": false
  },
  "isolation": {
    "safe": "auto",
    "work": "none"
  },
  "worktrees": {
    "dataHome": null,
    "autoPrune": {
      "enabled": false,
      "mergedOlderThanDays": 7
    }
  }
}
